{
  "name": "velobase",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source usage credit engine for AI and SaaS products",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "db:down": "docker compose down",
    "db:up": "docker compose up --detach --wait postgres",
    "demo": "pnpm --filter @velobase/example-ai-video demo",
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm --workspace-concurrency=1 --recursive test",
    "test:integration": "TEST_DATABASE_URL=postgresql://velobase:velobase@127.0.0.1:54329/velobase pnpm test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
