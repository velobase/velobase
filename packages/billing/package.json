  "description": "A reliable usage credit engine for AI and SaaS products",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "velobase-billing": "./bin/velobase-billing.js"
  },
  "files": [
