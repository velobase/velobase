# The exact release used by docker compose. Pin this in production.
VELOBASE_IMAGE=ghcr.io/velobase/velobase:0.1.1

# The bundled HTTP adapter is intentionally local-only because it has no auth.
VELOBASE_BIND_ADDRESS=127.0.0.1
VELOBASE_PORT=3000

# Every operation is isolated to this trusted tenant and project context.
VELOBASE_TENANT_ID=demo
VELOBASE_PROJECT_ID=ai-video

# Only used by compose.dev.yaml to expose PostgreSQL to host-side tests.
VELOBASE_POSTGRES_PORT=54329
